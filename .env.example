# ---------------------------------------------------------------------------
# Supabase — get these from your Supabase project: Settings → API
# Leave blank to run the app in fully local demo mode (localStorage + mock AI).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# DeepSeek AI — https://platform.deepseek.com  (used server-side only)
# Leave blank to fall back to the built-in rule-based scoring engine.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
